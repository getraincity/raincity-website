# ============================================================
# RainCity PMS — environment variable reference
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
# ============================================================

# Quote form — the form always posts to /api/contact, which emails each
# request to raincitypms@gmail.com through Resend. RESEND_API_KEY is the
# only variable it needs (set in Vercel → Settings → Environment Variables).

# Resend API key (https://resend.com — free tier: 100 emails/day).
# The account (getraincitypms@gmail.com) has raincitypms.com verified for
# sending; the DNS records are in Hostinger. API Keys → Create API Key.
RESEND_API_KEY=

# Optional "From" override. Leave unset: it defaults to
# quotes@raincitypms.com. Any address set here must be on a domain verified
# in Resend, or every quote fails with a 403.
# RESEND_FROM_EMAIL=RainCity Website <quotes@raincitypms.com>

# Google Maps Embed API key — required for the service-area maps on the
# homepage, /locations and each /locations/[slug] community page.
# Steps to set up:
#   1. Go to https://console.cloud.google.com and select (or create) your project
#   2. Enable the "Maps Embed API" under APIs & Services → Library
#   3. Confirm billing is active (Maps Embed API requires a billing account)
#   4. Go to APIs & Services → Credentials → Create Credentials → API Key
#   5. Restrict the key:
#        Application restrictions → HTTP referrers → add  raincitypms.com/*
#        API restrictions → Restrict key → select "Maps Embed API" only
#   6. Paste the key below
# Without this key the map panels render a text fallback instead of an
# interactive map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ============================================================
# Analytics and search indexing need NOTHING here — on purpose.
# ============================================================
# This block exists so that the next person handed a set of credentials for
# either of them does not go looking for a home for them in this file, or
# "improve" a hardcoded ID into a variable. Both would break something quietly.
#
# Google Analytics 4 — measurement ID G-SJE51YKEFY, hardcoded in
# app/layout.tsx. It is printed in the HTML of every page, so it is not a
# secret, and reading it from the environment would mean a value missing from
# the host's dashboard silently switches analytics off on a deploy. Microsoft
# Clarity's project ID sits beside it for the same reason. The load-bearing
# part of either tag is the Content-Security-Policy in next.config.ts, not a
# variable — see the notes on script-src, connect-src and img-src there.
#
# IndexNow / Bing — the key is public by design. IndexNow verifies ownership by
# having the key served from this domain, so it lives at
# public/<key>.txt and is committed deliberately. `npm run indexnow` reads it
# out of that served file, so there is nothing to configure.
#
# Bing Webmaster Tools also offers an OAuth client ID and client secret on the
# same API access page. NOTHING IN THIS PROJECT USES THEM. They are for an
# application that reads or writes a Webmaster Tools account on a user's
# behalf; IndexNow needs no authentication at all. If you are holding a pair,
# they do not belong in this file, in .env.local, or anywhere in this
# repository — and a secret that has been pasted into a chat or an email should
# be rotated in Bing Webmaster Tools rather than stored somewhere safer.
