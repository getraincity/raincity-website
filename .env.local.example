# ============================================================
# RainCity PMS — environment variable reference
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
# ============================================================

# Quote form endpoint — set to the server-side API route below.
# This tells QuoteForm.tsx where to POST submissions instead of
# falling back to the mailto: link.
NEXT_PUBLIC_FORM_ENDPOINT=/api/contact

# Resend API key (https://resend.com — free tier: 100 emails/day).
# Steps to set up:
#   1. Create a free account at https://resend.com
#   2. Go to Domains → Add Domain → verify raincitypms.com (add the
#      DNS records Resend shows to your domain host)
#   3. Go to API Keys → Create API Key (Full access)
#   4. Paste the key below
RESEND_API_KEY=

# The "From" address on quote notification emails.
# Must be from a domain you have verified in Resend (step 2 above).
# The default below works once raincitypms.com is verified.
RESEND_FROM_EMAIL=noreply@raincitypms.com
